<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Claudium.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Claudium"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Claudium"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Background="{StaticResource AppSurfaceBrush}"
                  Foreground="{StaticResource AppTextPrimaryBrush}"
                  HorizontalContentAlignment="Left">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!-- The native caption buttons keep their reserved space at the right. -->
                <Grid x:Name="TitleBarContentHost"
                      Margin="0,0,152,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Claudium"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <ScrollViewer Grid.Column="0"
                                  Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled"
                                  VerticalAlignment="Bottom">
                        <ItemsRepeater x:Name="TitleBarTabsRepeater"
                                       HorizontalAlignment="Left">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:TerminalTabItem">
                                    <Grid Width="104"
                                          Height="40"
                                          Margin="0,4,0,0"
                                          Tag="{x:Bind SessionId}"
                                          Tapped="TitleBarTab_Tapped">
                                        <Border Background="{x:Bind OpenTabBackground}"
                                                BorderBrush="{x:Bind OpenTabBorderBrush}"
                                                BorderThickness="1,1,1,0"
                                                CornerRadius="6,6,0,0"
                                                Padding="8,0">
                                            <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{x:Bind StatusDotBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{x:Bind StatusDotVisibility}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name}"
                                                       Foreground="{x:Bind TextBrush}"
                                                       FontSize="12"
                                                       FontWeight="{x:Bind NameFontWeight}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2"
                                                    Width="18"
                                                    Height="18"
                                                    Padding="0"
                                                    FontSize="9"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource AppTextSecondaryBrush}"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    Tag="{x:Bind SessionId}"
                                                    Click="TitleBarCloseTabButton_Click"
                                                    ToolTipService.ToolTip="Stäng flik">
                                                <SymbolIcon Symbol="Cancel" />
                                            </Button>
                                        </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                        <Button Grid.Column="1"
                                Visibility="Collapsed"
                                Width="28"
                                Height="28"
                                Padding="0"
                                FontSize="14"
                                Margin="4,8,0,0"
                                Background="Transparent"
                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Click="TitleBarAddTabButton_Click"
                                ToolTipService.ToolTip="Starta ny session">
                            <SymbolIcon Symbol="Add" />
                        </Button>

                    <TabView x:Name="TitleBarTabsView"
                             Grid.Column="1"
                             Height="44"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Left"
                             Background="Transparent"
                             BorderThickness="0"
                             TabWidthMode="SizeToContent"
                             IsAddTabButtonVisible="False"
                             CanDragTabs="False"
                             CanReorderTabs="False"
                             SelectionChanged="TitleBarTabsView_SelectionChanged"
                             AddTabButtonClick="TitleBarTabsView_AddTabButtonClick"
                             TabCloseRequested="TitleBarTabsView_TabCloseRequested">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="local:TerminalTabItem">
                                <TabViewItem IsClosable="True">
                                    <TabViewItem.Header>
                                        <TextBlock Text="{x:Bind Name}"
                                                   Foreground="{x:Bind TextBrush}"
                                                   FontSize="13"
                                                   FontWeight="{x:Bind NameFontWeight}"
                                                   MaxWidth="150"
                                                   TextTrimming="CharacterEllipsis" />
                                    </TabViewItem.Header>
                                </TabViewItem>
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                    </TabView>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
