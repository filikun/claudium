<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Claudium.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Claudium"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared chrome brushes — the app's single, fixed color scheme (no theme picker). -->
            <SolidColorBrush x:Key="AppPageBrush" Color="#E0151C2C" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#E01B2638" />
            <SolidColorBrush x:Key="AppSurfaceOverlayBrush" Color="#CC1B2638" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4B8CFF" />
            <SolidColorBrush x:Key="AppNeutralButtonBrush" Color="#2A2E38" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#1AFFFFFF" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F1F2F5" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#B9C0CF" />
            <SolidColorBrush x:Key="AppTextTertiaryBrush" Color="#959DAC" />
            <SolidColorBrush x:Key="AppFavoriteBrush" Color="#F5C451" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#4FAE7A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
